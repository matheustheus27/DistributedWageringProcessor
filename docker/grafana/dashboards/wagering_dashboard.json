  "panels": [
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Wagering Transactions Rate by Status",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(wagering_transactions_total[1m])",
          "legendFormat": "{{status}} - {{kind}}"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Outbox Lag (Pending Events)",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "wagering_outbox_lag",
          "legendFormat": "Outbox Lag"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Deduplication & Replay Count",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "wagering_duplicates_detected_total",
          "legendFormat": "Duplicates Detected"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Transaction Processing Latency (p95)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(wagering_transaction_processing_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency (s)"
        }
      ]
    }
  ],
  "refresh": "5s",
